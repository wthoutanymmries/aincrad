model User {
  id String @id @default(cuid())

  name       String
  surname    String
  patronymic String
  isManager  Boolean @default(false)

  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  managerId String?
  manager   User?   @relation("UserReportsTo", fields: [managerId], references: [id])
  reports   User[]  @relation("UserReportsTo")

  authoredTasks Task[] @relation("AuthorTasks")
  managedTasks  Task[] @relation("ManagerTasks")

  @@unique([email])
  @@map("user")
}
