enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum Status {
  TO_BE_DONE
  IN_PROGRESS
  FINISHED
  CANCELED
}

model Task {
  id String @id @default(cuid())

  title        String
  description String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  endsAt    DateTime

  priority Priority
  status   Status   @default(TO_BE_DONE)

  author    User    @relation("AuthorTasks", fields: [ownerId], references: [id])
  ownerId  String
  manager   User?   @relation("ManagerTasks", fields: [managerId], references: [id])
  managerId String?
}
